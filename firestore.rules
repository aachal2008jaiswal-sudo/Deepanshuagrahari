rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // This app uses Firebase Admin SDK only from the trusted Node.js server.
    // Admin SDK bypasses these rules; do not expose server credentials to the browser.
    // Deny direct browser access by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
